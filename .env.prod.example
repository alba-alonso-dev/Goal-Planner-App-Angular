# Copia a .env.prod (no se versiona) y rellena los valores.
POSTGRES_PASSWORD=
# openssl rand -base64 48
JWT_SECRET=
# URL pública de la aplicación (enlaces de los emails), sin barra final
APP_URL=https://goals.example.com
SMTP_URL=smtp://usuario:clave@smtp.example.com:587
MAIL_FROM=Goal Planner <no-reply@example.com>
# Web Push (opcional): cd server && npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Solo para probar en local sin HTTPS: false (en producción, siempre true)
COOKIE_SECURE=true
WEB_PORT=8080
