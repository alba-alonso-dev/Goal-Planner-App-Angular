# Copia este archivo a .env (no se versiona) o exporta las variables en tu entorno.
DATABASE_URL=postgres://goal:goal@localhost:5432/goal_planner
# Obligatorio en producción (mínimo 32 caracteres). Genera uno con: openssl rand -base64 48
JWT_SECRET=
PORT=3000
# Duración de la sesión en segundos (7 días por defecto)
SESSION_TTL_SECONDS=604800
# Intentos de login/registro por minuto y cliente
AUTH_RATE_LIMIT=10
# true para enviar la cookie solo por HTTPS (por defecto: activado si NODE_ENV=production)
COOKIE_SECURE=
# URL pública del frontend (enlaces de los emails). Obligatoria en producción
APP_URL=http://localhost:4200
# Servidor SMTP para los emails (recuperación de contraseña). Obligatorio en producción.
# En desarrollo, sin él los emails solo se escriben en el log (docker compose incluye Mailpit: smtp://localhost:1025)
SMTP_URL=
MAIL_FROM=Goal Planner <no-reply@goal-planner.local>
# Desarrollo/tests: guarda cada email como JSON en esta carpeta
MAIL_OUTBOX_DIR=
